    "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>C9 TEAM Official Game Store 🏴‍☠️</title>\n\n<style>\n*{margin:0;padding:0;box-sizing:border-box;}\nbody{\n    font-family:'Segoe UI',sans-serif;\n    background: radial-gradient(circle at top, #000000, #001f1f);\n    color:#fff;\n}\n\n/* NAVBAR */\nnav{\n    display:flex;\n    justify-content:space-between;\n    padding:20px 50px;\n    background:#000;\n    border-bottom:2px solid #00ffff;\n    box-shadow:0 0 20px #00ffff;\n}\nnav h1{\n    color:#00ffff;\n    text-shadow:0 0 15px #00ffff;\n}\nnav a{\n    color:#fff;\n    margin-left:20px;\n    text-decoration:none;\n    font-weight:bold;\n}\nnav a:hover{\n    color:#00ffcc;\n}\n\n/* HERO */\n.hero{\n    text-align:center;\n    padding:80px 20px;\n}\n.hero h2{\n    font-size:42px;\n    color:#00ffff;\n    text-shadow:0 0 20px #00ffff;\n}\n.hero p{\n    margin:15px 0;\n    color:#aaa;\n    font-size:18px;\n}\n\n/* INPUT & BUTTON */\n.input-box{\n    margin-top:20px;\n}\ninput{\n    padding:12px;\n    width:250px;\n    background:#111;\n    border:none;\n    border-radius:5px;\n    color:#00ffff;\n    outline:none;\n    box-shadow:0 0 15px #00ffff;\n}\n.btn{\n    padding:12px 30px;\n    margin-top:15px;\n    background:#00ffff;\n    color:black;\n    border:none;\n    border-radius:5px;\n    font-weight:bold;\n    cursor:pointer;\n    box-shadow:0 0 20px #00ffff;\n    transition:0.3s;\n}\n.btn:hover{\n    background:#00cc99;\n    box-shadow:0 0 30px #00ffcc;\n}\n\n/* SECTIONS */\n.section{\n    padding:60px 20px;\n    text-align:center;\n}\n.cards{\n    display:flex;\n    flex-wrap:wrap;\n    justify-content:center;\n}\n.card{\n    background:#111;\n    width:260px;\n    margin:15px;\n    padding:25px;\n    border-radius:12px;\n    box-shadow:0 0 20px rgba(0,255,255,0.4);\n    transition:0.3s;\n}\n.card:hover{\n    transform:scale(1.05);\n}\n.card h3{\n    color:#00ffff;\n    margin-bottom:10px;\n}\n.price{\n    color:#00ffcc;\n    font-size:20px;\n    font-weight:bold;\n}\n.feature{\n    width:250px;\n    margin:10px;\n    padding:15px;\n    background:#111;\n    border-radius:10px;\n    box-shadow:0 0 15px #00ffff;\n}\n\n/* COMING SOON */\n.coming{\n    background:#000;\n    padding:50px 20px;\n}\n.coming p{\n    margin:10px 0;\n    color:#00ffcc;\n    font-weight:bold;\n}\n\n/* STATUS BOX */\n.status{\n    display:none;\n    margin-top:20px;\n    padding:15px;\n    border-radius:8px;\n    background:#111;\n    box-shadow:0 0 15px #00ffff;\n}\n\n/* FOOTER */\nfooter{\n    text-align:center;\n    padding:25px;\n    border-top:2px solid #00ffff;\n    color:#aaa;\n    font-size:14px;\n}\n\n</style>\n</head>\n<body>\n\n<!-- NAV -->\n<nav>\n    <h1>🏴‍☠️ C9 TEAM STORE</h1>\n    <div>\n        <a href=\"#\">Home</a>\n        <a href=\"#\">Yalla Ludo</a>\n        <a href=\"#\">VIP</a>\n        <a href=\"#\">Updates</a>\n    </div>\n</nav>\n\n<!-- HERO -->\n<section class=\"hero\">\n    <h2>💎 Yalla Ludo Diamond Store</h2>\n    <p>Official se thoda sasta • Fast delivery • Secure payment</p>\n\n    <div class=\"input-box\">\n        <input type=\"text\" id=\"userId\" placeholder=\"Enter Your Game ID\">\n    </div>\n    <br>\n    <a href=\"https://easypaisa.com/pay/YOUR_LINK\" target=\"_blank\">\n        <button class=\"btn\" onclick=\"buyNow()\">💳 Buy Now</button>\n    </a>\n\n    <div class=\"status\" id=\"statusBox\">⏳ Processing Payment...</div>\n    <div class=\"status\" id=\"successBox\">🎉 Diamonds Credited Successfully!</div>\n</section>\n\n<!-- SMALL DEALS -->\n<section class=\"section\">\n    <h2>💎 Small & Medium Diamond Deals</h2>\n    <div class=\"cards\">\n        <div class=\"card\"><h3>100 Diamonds</h3><p class=\"price\">PKR 260</p></div>\n        <div class=\"card\"><h3>500 Diamonds</h3><p class=\"price\">PKR 1200</p></div>\n        <div class=\"card\"><h3>1000 Diamonds</h3><p class=\"price\">PKR 2300</p></div>\n        <div class=\"card\"><h3>2000 Diamonds</h3><p class=\"price\">PKR 4400</p></div>\n    </div>\n</section>\n\n<!-- BIG DEALS -->\n<section class=\"section\">\n    <h2>🔥 Mega / Ultra / King Deals</h2>\n    <div class=\"cards\">\n        <div class=\"card\"><h3>🔥 Mega Pack</h3><p>5000 Diamonds</p><p class=\"price\">PKR 10,500</p></div>\n        <div class=\"card\"><h3>🚀 Ultra Pack</h3><p>10000 Diamonds</p><p class=\"price\">PKR 19,500</p></div>\n        <div class=\"card\"><h3>👑 King Pack</h3><p>20000 Diamonds</p><p class=\"price\">PKR 37,000</p></div>\n    </div>\n</section>\n\n<!-- VIP SECTION -->\n<section class=\"section\">\n    <h2>👑 VIP Membership</h2>\n    <div class=\"cards\">\n        <div class=\"card\"><h3>Basic VIP</h3><p>Extra rewards + priority</p><p class=\"price\">PKR 1300</p></div>\n        <div class=\"card\"><h3>Pro VIP</h3><p>Faster delivery + bonus diamonds</p><p class=\"price\">PKR 2600</p></div>\n        <div class=\"card\"><h3>Elite VIP</h3><p>Full access + unlimited perks</p><p class=\"price\">PKR 4500</p></div>\n    </div>\n</section>\n\n<!-- COMING SOON -->\n<section class=\"coming\">\n    <h2>🆕 Coming Soon</h2>\n    <p>🔥 Auto Diamond Delivery System</p>\n    <p>🔥 More Game Integrations</p>\n    <p>🔥 Live Dashboard & Tracking</p>\n</section>\n\n<!-- FOOTER -->\n<footer>\n    © 2026 C9 TEAM 🏴‍☠️ | Owner: Professor Rehan | All Rights Reserved\n</footer>\n\n<script>\nfunction buyNow(){\n    let id=document.getElementById(\"userId\").value;\n    if(id===\"\"){alert(\"⚠️ Enter your Game ID first!\"); return;}\n    document.getElementById(\"statusBox\").style.display=\"block\";\n    setTimeout(()=>{\n        document.getElementById(\"statusBox\").style.display=\"none\";\n        document.getElementById(\"successBox\").style.display=\"block\";\n    },4000);\n}\n</script>\n\n</body>\n</html><section class=\"section\">\n    <h2>🎫 C9 TEAM Official Deals</h2>\n\n    <div class=\"cards\">\n\n        <div class=\"card\">\n            <h3>💎 Starter Deal</h3>\n            <p>5,000 Diamonds</p>\n            <p class=\"price\">PKR 2,000</p>\n            <p style=\"color:#00ffcc;\">✔ Best Entry Deal</p>\n        </div>\n\n        <div class=\"card\">\n            <h3>💎 Silver Deal</h3>\n            <p>7,000 Diamonds</p>\n            <p class=\"price\">PKR 4,000</p>\n        </div>\n\n        <div class=\"card\">\n            <h3>💎 Gold Deal</h3>\n            <p>10,000 Diamonds</p>\n            <p class=\"price\">PKR 6,000</p>\n            <p style=\"color:#00ffcc;\">🔥 Most Popular</p>\n        </div>\n\n        <div class=\"card\">\n            <h3>💎 Platinum Deal</h3>\n            <p>16,000 Diamonds</p>\n            <p class=\"price\">PKR 8,000</p>\n        </div>\n\n        <div class=\"card\">\n            <h3>💎 Diamond Deal</h3>\n            <p>32,000 Diamonds</p>\n            <p class=\"price\">PKR 10,000</p>\n            <p style=\"color:#00ffcc;\">🚀 Best Value</p>\n        </div>\n\n        <div class=\"card\">\n            <h3>👑 King Deal</h3>\n            <p>53,000 Diamonds</p>\n            <p class=\"price\">PKR 20,000</p>\n        </div>\n\n    </div>\n</section>"
